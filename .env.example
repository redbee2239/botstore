# Discord Bot Token
DISCORD_TOKEN=your_bot_token_here

# Client ID
CLIENT_ID=your_client_id_here

# Owner ID
OWNER_ID=your_owner_id_here

# Prefix for commands (optional, fallback if no slash commands)
PREFIX=!

# Developer Guild ID (for registering slash commands during dev)
GUILD_ID=your_guild_id_here

# Channel that receives closed-ticket transcript files
TICKET_LOG_CHANNEL_ID=your_ticket_log_channel_id_here
